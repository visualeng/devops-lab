# Скопируйте в terraform.tfvars и правьте под себя.
# Сам файл в git не кладём: адреса и имена — это личные данные.

server_name  = "devops-lab"
server_type  = "cx22"
location     = "fsn1"
image        = "ubuntu-24.04"

# Ключ должен уже существовать в Hetzner Cloud.
ssh_key_name = "deploy-key"

# Откуда пускать ssh. 203.0.113.0/24 — это адреса из документации
# (RFC 5737), сюда стоит подставить свой домашний адрес.
allowed_cidrs = ["203.0.113.10/32"]
